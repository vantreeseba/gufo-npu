# Copy to .env and set the paths to your GGUFs (Unsloth UD-Q4_K_XL).
QWEN36_35B_GGUF=/path/to/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
QWEN35_4B_GGUF=/path/to/Qwen3.5-4B-UD-Q4_K_XL.gguf
QWEN35_2B_GGUF=/path/to/Qwen3.5-2B-UD-Q4_K_XL.gguf

# The all-models service: the model loaded at start, and seconds an idle
# model stays loaded (0: until another model is asked for).
GUFO_NPU_PRELOAD=qwen3.6-35b-a3b
GUFO_NPU_UNLOAD_AFTER=0

# Image tag (main, a branch, or sha-<commit>).
GUFO_NPU_TAG=main

# Where the API listens on the host. 127.0.0.1 keeps it local; 0.0.0.0
# accepts other machines (add --api-key to the command then).
GUFO_NPU_BIND=127.0.0.1
GUFO_NPU_HOST_PORT=8080
